# ── データベース ──────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# PostgreSQL 個別設定（DATABASE_URL があれば不要）
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# ── 認証 ─────────────────────────────────────
SESSION_SECRET=ここに長いランダム文字列を設定（例: openssl rand -hex 32）

GOOGLE_CLIENT_ID=Googleで取得したクライアントID
GOOGLE_CLIENT_SECRET=Googleで取得したクライアントシークレット
# VPS本番のコールバックURL（ドメインに合わせて変更）
GOOGLE_CALLBACK_URL=https://YOUR_DOMAIN/crm/api/callback

# ── AI機能（OpenAI） ──────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Gmail送信（請求書メール） ─────────────────
# Google Cloud Console で取得した OAuth2 認証情報
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=送信元のGmailアドレス

# ── サーバー ──────────────────────────────────
PORT=5000
NODE_ENV=production
